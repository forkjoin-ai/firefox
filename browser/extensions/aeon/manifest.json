{
  "manifest_version": 2,
  "name": "Aeon Bridge",
  "version": "0.1.0",
  "description": "Bridge Aeon Flow frames, Bitwise pneuma codecs, UDP transport, and Lacey state through a native host.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aeon@forkjoin.ai"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "browser_action": {
    "default_title": "Moonshine",
    "default_popup": "commandbar.html"
  },
  "background": {
    "scripts": ["run.js"]
  }
}
